# Copy to .env.local and fill values locally. Never commit real credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
ANTHROPIC_API_KEY=your_anthropic_api_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APP_URL=http://localhost:3000
CRON_SECRET=generate_a_long_random_secret
GOOGLE_RISC_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_RISC_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
ELEVENLABS_API_KEY=your_elevenlabs_api_key
